rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tài khoản người dùng (học sinh, giáo viên, quản trị) - đồng bộ danh sách & thông tin
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // Kho đề thi & bộ luyện đề (trắc nghiệm + tự luận từng câu)
    match /exams/{examId} {
      allow read: if true;
      allow write: if true;
    }

    // Bài nộp & lịch sử làm bài (kèm quản trị xóa lịch sử / BXH)
    match /submissions/{subId} {
      allow read: if true;
      allow write: if true;
    }

    // Giám sát phòng khảo thí trực tuyến
    match /participants/{partId} {
      allow read: if true;
      allow write: if true;
    }

    // Bài chữa viết tay A4 của giáo viên / quản trị
    match /handwrittenSolutions/{setId} {
      allow read: if true;
      allow write: if true;
    }

    // Cấu hình lớp học & dữ liệu đồng bộ chung hệ thống
    match /systemState/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
